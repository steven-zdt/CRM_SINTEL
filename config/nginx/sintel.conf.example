# Configuración de Nginx para Sintel (Producción)
# 
# Instrucciones:
# 1. Copiar este archivo a /etc/nginx/sites-available/sintel
# 2. Crear symlink: ln -s /etc/nginx/sites-available/sintel /etc/nginx/sites-enabled/
# 3. Ajustar las rutas de certificados y el upstream según tu configuración
# 4. Probar: nginx -t
# 5. Recargar: systemctl reload nginx

# Upstream para Django (Gunicorn/Uvicorn)
upstream django_app {
    server app:8000;  # Ajustar según tu configuración (Docker, servidor, etc.)
    # Para múltiples workers, usar:
    # server app1:8000;
    # server app2:8000;
}

# Redirección HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name sintel.net.co *.sintel.net.co;

    # Redirigir todo a HTTPS
    return 301 https://$host$request_uri;
}

# Servidor HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sintel.net.co *.sintel.net.co;

    # Certificados TLS (ajustar rutas según tu configuración)
    ssl_certificate     /etc/ssl/sintel/fullchain.pem;
    ssl_certificate_key /etc/ssl/sintel/privkey.pem;

    # Configuración SSL moderna (TLS 1.2+)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/ssl/sintel/chain.pem;

    # Headers de seguridad
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Tamaño máximo de body (ajustar según necesidades)
    client_max_body_size 10M;

    # Logs
    access_log /var/log/nginx/sintel_access.log;
    error_log /var/log/nginx/sintel_error.log;

    # ⚠️ CRÍTICO: Servir archivos estáticos directamente desde Nginx
    # Esto mejora el rendimiento y reduce la carga en Django
    location /static/ {
        alias /app/staticfiles/;  # Ajustar según tu configuración
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /media/ {
        alias /app/media/;  # Ajustar según tu configuración
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # Proxy a Django
    location / {
        # ⚠️ CRÍTICO: Mantener Host intacto
        # django-tenants usa el Host para resolver el tenant
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering (opcional, mejorar rendimiento)
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # Reenvío a Django
        proxy_pass http://django_app;

        # Manejo de errores
        proxy_intercept_errors off;
    }

    # Health check endpoint (opcional)
    location /health {
        proxy_pass http://django_app;
        access_log off;
    }
}
