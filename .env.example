# .env.example — Plantilla de variables de entorno para CRM Sintel
#
# INSTRUCCIONES:
#   cp .env.example .env
#   Completar cada valor. NUNCA commitear el .env real al repositorio.
#
# Generar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Generar JWT_SECRET_KEY:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# ── Nucleo Django ────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=<generar con token_urlsafe(50) — minimo 50 chars>
JWT_SECRET_KEY=<generar con base64(token_bytes(32)) — minimo 32 bytes>
TIME_ZONE=America/Bogota
SITE_PROTOCOL=https

# ── Dominio y hosts ──────────────────────────────────────────────────────────
TENANT_DOMAIN_BASE=sintel.com
ALLOWED_HOSTS=sintel.com,.sintel.com
CSRF_TRUSTED_ORIGINS=https://sintel.com,https://.sintel.com

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
DATABASE_NAME=sintel_prod
DATABASE_USER=sintel_prod
DATABASE_PASSWORD=<password fuerte — minimo 24 chars>
DATABASE_HOST=db
DATABASE_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Neo4j / Enterprise Knowledge Graph (tools/ekg/) ─────────────────────────
NEO4J_PASSWORD=<password fuerte — minimo 24 chars>
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ── Email SMTP ───────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<correo@dominio.com>
EMAIL_HOST_PASSWORD=<app password de Gmail o credencial SMTP>
DEFAULT_FROM_EMAIL=<correo@dominio.com>

# ── Activacion de tenants ────────────────────────────────────────────────────
ACTIVATION_BASE_URL=https://sintel.com
ALLOW_RESET_ACTIVATION=False
OWNER_ACTIVATION_TOKEN_TTL_MINUTES=120

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Obtener en: Cloudflare Zero Trust > Networks > Tunnels > sintel-erp-prod > Configure
# El token identifica el tunel — tratar como secreto (nunca commitear).
TUNNEL_TOKEN=<token copiado del dashboard de Cloudflare Zero Trust>

# ── IA — Claude API (Agentes Contables) ─────────────────────────────────────
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<sk-ant-...>

# ── Integraciones opcionales ─────────────────────────────────────────────────
DIAN_AMBIENTE=produccion
DIAN_API_KEY=
DIAN_API_URL_TEST=https://api-test.dian.gov.co
DIAN_API_URL_PRODUCTION=https://api.dian.gov.co

# ── Backups y logs ───────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
AUDIT_LOG_DIR=logs/audit
AUDIT_LOG_LEVEL=INFO

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_DOCUMENT_PIPELINE=true
FEATURE_UPLOAD_DOCUMENT_ENDPOINT=false
DASHBOARD_API_FIRST=True
