# .env.example — Plantilla de variables de entorno para CRM Sintel
#
# INSTRUCCIONES:
#   cp .env.example .env
#   Completar cada valor. NUNCA commitear el .env real al repositorio.
#
# Generar SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Generar JWT_SECRET_KEY:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# ── Nucleo Django ────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=<generar con token_urlsafe(50) — minimo 50 chars>
JWT_SECRET_KEY=<generar con base64(token_bytes(32)) — minimo 32 bytes>
TIME_ZONE=America/Bogota
SITE_PROTOCOL=https

# ── Dominio y hosts ──────────────────────────────────────────────────────────
TENANT_DOMAIN_BASE=sintel.net.co
ALLOWED_HOSTS=sintel.net.co,.sintel.net.co
CSRF_TRUSTED_ORIGINS=https://sintel.net.co,https://.sintel.net.co

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
DATABASE_NAME=sintel_prod
DATABASE_USER=sintel_prod
DATABASE_PASSWORD=<password fuerte — minimo 24 chars>
DATABASE_HOST=db
DATABASE_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Neo4j / Enterprise Knowledge Graph (tools/ekg/) ─────────────────────────
NEO4J_PASSWORD=<password fuerte — minimo 24 chars>
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ── Email SMTP ───────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<correo@dominio.com>
EMAIL_HOST_PASSWORD=<app password de Gmail o credencial SMTP>
DEFAULT_FROM_EMAIL=<correo@dominio.com>

# ── Activacion de tenants ────────────────────────────────────────────────────
ACTIVATION_BASE_URL=https://sintel.net.co
ALLOW_RESET_ACTIVATION=False
OWNER_ACTIVATION_TOKEN_TTL_MINUTES=120

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Obtener en: Cloudflare Zero Trust > Networks > Tunnels > sintel-erp-prod > Configure
# El token identifica el tunel — tratar como secreto (nunca commitear).
TUNNEL_TOKEN=<token copiado del dashboard de Cloudflare Zero Trust>

# ── IA — Claude API (Agentes Contables) ─────────────────────────────────────
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<sk-ant-...>

# ── Integraciones opcionales ─────────────────────────────────────────────────
DIAN_AMBIENTE=produccion
DIAN_API_KEY=
DIAN_API_URL_TEST=https://api-test.dian.gov.co
DIAN_API_URL_PRODUCTION=https://api.dian.gov.co

# ── Backups y logs ───────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
AUDIT_LOG_DIR=logs/audit
AUDIT_LOG_LEVEL=INFO

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_DOCUMENT_PIPELINE=true
FEATURE_UPLOAD_DOCUMENT_ENDPOINT=false
DASHBOARD_API_FIRST=True

# ── n8n (N8N-SINTEL-01) — orquestador externo, aislado de SINTEL ────────────
# n8n NUNCA recibe DATABASE_*/DATABASE_PASSWORD — tiene su propia base de
# datos separada (mismo servidor Postgres, rol/DB dedicados, CONNECT a la
# base de SINTEL revocado explicitamente). Ver docs/n8n/N8N_SECURITY.md.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=<64 caracteres hex — generar uno, no reutilizar entre entornos>
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=<password fuerte, generar con secrets.token_urlsafe(24)>
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# El ACCESS token de la identidad tecnica de n8n (JWT) NO vive aqui --
# se genera con `manage.py crear_identidad_tecnica_n8n --schema <tenant>`
# y se guarda como credencial cifrada DENTRO de n8n (Header Auth),
# nunca en este .env. Habilitar FEATURE_UPLOAD_DOCUMENT_ENDPOINT
# (arriba, seccion Feature flags) es requisito para que esa identidad
# pueda subir documentos.
# EXCEPCION documentada (N8N-SINTEL-02, docs/n8n/workflows/README.md):
# el REFRESH token si vive aqui, como SINTEL_N8N_REFRESH_TOKEN abajo --
# el workflow importado lo necesita dentro de un body JSON (POST
# /api/token/refresh/), y el Code node de n8n NO tiene acceso a
# credenciales por diseño de n8n (solo los nodos nativos como HTTP
# Request si pueden inyectar una credencial, y solo como header/query/
# basic auth, no como campo de body). Tradeoff aceptado: el .env local
# ya protege otros secretos reales de este proyecto (ver mas abajo).
SINTEL_N8N_REFRESH_TOKEN=
# URL del nodo Webhook de n8n que recibe eventos de SINTEL (Fase 8) —
# vacio hasta crear el workflow receptor en la UI de n8n. Debe apuntar
# al servicio Docker (`http://n8n:5678/webhook/<path>`), NUNCA a
# 127.0.0.1 -- quien llama es el contenedor celery, no el host.
N8N_WEBHOOK_URL=
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mismo valor se pasa automaticamente al contenedor n8n (docker-compose.yaml)
# -- no duplicar en ningun otro lugar.
N8N_WEBHOOK_SECRET=<secreto compartido — n8n valida X-Sintel-Signature con este mismo valor>
# N8N-SINTEL-02: variables de negocio de los workflows importados
# (docs/n8n/workflows/README.md tiene la checklist completa)
SINTEL_WHATSAPP_PHONE_NUMBER_ID=
SINTEL_DEPT_CONTABILIDAD_EMAIL=
SINTEL_DEPT_CONTABILIDAD_WHATSAPP=
SINTEL_DEPT_ADMINISTRACION_EMAIL=
SINTEL_DEPT_ADMINISTRACION_WHATSAPP=
SINTEL_DEPT_TI_EMAIL=
