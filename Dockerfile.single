# Dockerfile.single -- imagen "contenedor unico" para desarrollo (docker-compose.single.yaml).
#
# ALCANCE: SOLO desarrollo local (decision explicita del usuario, 2026-09-22,
# ver docker/supervisord.conf). Produccion sigue usando el Dockerfile
# multi-contenedor (Dockerfile + docker-compose.yaml + docker-compose.prod.yaml)
# -- este archivo es una alternativa nueva y separada, no un reemplazo.
#
# Empaqueta los 9 procesos que hoy corren en contenedores separados dentro de
# UNA sola imagen Debian (python:3.12-slim = Debian trixie), orquestados por
# supervisord: postgres, redis, django, celery, celery-beat, neo4j, n8n,
# nginx, cloudflared. Ver docker/supervisord.conf para el orden de arranque
# y docker/start-*.sh para la logica de cada uno.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

COPY requirements.txt /app/requirements.txt

# ── Capa 1: dependencias de sistema para compilar/instalar requirements.txt ──
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        netcat-openbsd \
        libffi-dev \
        libxml2-dev \
        libxslt1-dev \
        curl \
        wget \
        gpg \
        ca-certificates \
        openssl \
        procps && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir supervisor && \
    apt-get purge -y gcc && \
    apt-get autoremove -y

# ── Capa 2: PostgreSQL 16 + pgvector (mismo repo PGDG que ya usaba el
# Dockerfile multi-contenedor para el cliente -- aqui se agrega el SERVIDOR y
# la extension pgvector precompilada para v16) ────────────────────────────────
RUN install -d /usr/share/postgresql-common/pgdg && \
    curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc && \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        postgresql-16 \
        postgresql-16-pgvector && \
    apt-get autoremove -y

# ── Capa 3: Redis ─────────────────────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends redis-server

# ── Capa 4: Neo4j 5.24 community (paquete Debian oficial -- Neo4j 5.24 soporta
# Java 21; la base python:3.12-slim (Debian trixie) ya no empaqueta Java 17) ──
RUN apt-get install -y --no-install-recommends openjdk-21-jre-headless && \
    wget -qO- https://debian.neo4j.com/neotechnology.gpg.key | gpg --dearmor -o /usr/share/keyrings/neo4j.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/neo4j.gpg] https://debian.neo4j.com stable 5" > /etc/apt/sources.list.d/neo4j.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends "neo4j=1:5.24.*"

# ── Capa 5: Node.js 20 LTS + n8n 1.81.0 (imagen oficial de n8n NO se usa --
# n8n corre como proceso mas de supervisord, ver docker/supervisord.conf) ─────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g n8n@1.81.0 && \
    npm cache clean --force

# ── Capa 6: nginx + cloudflared ───────────────────────────────────────────────
RUN apt-get install -y --no-install-recommends nginx && \
    rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf && \
    ARCH="$(dpkg --print-architecture)" && \
    curl -L --fail --output /tmp/cloudflared.deb \
        "https://github.com/cloudflare/cloudflared/releases/download/2025.5.0/cloudflared-linux-${ARCH}.deb" && \
    apt-get install -y --no-install-recommends /tmp/cloudflared.deb && \
    rm -f /tmp/cloudflared.deb && \
    apt-get purge -y gpg wget && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# ── Usuario de aplicacion (mismo UID/GID 1000 que el Dockerfile multi-contenedor) ──
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -m -s /bin/bash appuser

# ── Directorios de datos y permisos por proceso (cada programa de
# supervisord.conf corre bajo un usuario distinto -- ver el `user=` de cada
# [program:x]) ─────────────────────────────────────────────────────────────
RUN mkdir -p /var/lib/postgresql/data /var/run/postgresql && \
    chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql && \
    mkdir -p /data/redis && chown -R appuser:appuser /data/redis && \
    chown -R appuser:appuser /var/lib/neo4j /etc/neo4j /var/log/neo4j && \
    mkdir -p /app/static /app/media /app/staticfiles /app/.fastembed_cache && \
    mkdir -p /home/appuser/.n8n && chown -R appuser:appuser /home/appuser/.n8n

# ── Codigo de la aplicacion ────────────────────────────────────────────────
COPY . /app

RUN python manage.py collectstatic --noinput

# nginx del contenedor unico usa su PROPIA config (upstream 127.0.0.1:8000,
# sin resolver de Compose) -- nginx/nginx.conf sigue siendo del nginx
# multi-contenedor, no se reutiliza aqui.
RUN cp /app/docker/nginx-single.conf /etc/nginx/conf.d/default.conf

RUN chmod +x /app/entrypoint.sh /app/entrypoint-celery.sh \
        /app/docker/entrypoint-single.sh /app/docker/wait-for.sh \
        /app/docker/start-postgres.sh /app/docker/start-django.sh \
        /app/docker/start-neo4j.sh /app/docker/start-nginx.sh && \
    ln -sf /app/docker/start-postgres.sh /usr/local/bin/docker-start-postgres.sh && \
    ln -sf /app/docker/start-django.sh /usr/local/bin/docker-start-django.sh && \
    ln -sf /app/docker/start-neo4j.sh /usr/local/bin/docker-start-neo4j.sh && \
    ln -sf /app/docker/start-nginx.sh /usr/local/bin/docker-start-nginx.sh && \
    chown -R appuser:appuser /app

# NO se fija USER aqui (a diferencia del Dockerfile multi-contenedor): el
# entrypoint corre supervisord como root -- requisito para que pueda hacer
# setuid a postgres/appuser por programa (ver `user=` en supervisord.conf) y
# para que nginx pueda bindear los puertos privilegiados 80/443.
ENTRYPOINT ["/app/docker/entrypoint-single.sh"]
